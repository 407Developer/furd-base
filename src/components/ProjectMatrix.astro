    structure: "Reinforced Concrete Raft",
    timeline: "Completed",
    image: "/assets/WhatsApp Image 2026-06-23 at 15.03.40.jpeg",
    blueprint: "/assets/3d-8.jpeg",
    description: "Real on-site foundation works — reinforcing steel, load-tested concrete, and careful compliance with our safety standards. This is where a great building begins.",
