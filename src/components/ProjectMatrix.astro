  {
    id: 6,
    title: "A premium finishing & facade project",
    owner: "FURD BASE Finishes",
    subtitle: "Finishing & Facade Works",
    location: "Abuja, Nigeria",
    country: "NG",
    area: "On-Site Works",
    structure: "Plastered Facade System",
    timeline: "Completed",
    image: "/assets/WhatsApp Image 2026-06-23 at 15.04.57.jpeg",
    blueprint: "/assets/real-2.jpeg",
