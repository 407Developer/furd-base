const ngFlag = `<svg class="inline-block w-5 h-3.5 rounded-[2px] shadow-sm" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="3.33" height="7" fill="#008751"/><rect x="6.67" width="3.33" height="7" fill="#008751"/></svg>`;
const aeFlag = `<svg class="inline-block w-5 h-3.5 rounded-[2px] shadow-sm" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="10" height="2.33" fill="#00732f"/><rect y="4.67" width="10" height="2.33" fill="#000"/><rect width="2.5" height="7" fill="#ce1127"/></svg>`;

const flagMap = { NG: ngFlag, AE: aeFlag };
const countryNameMap = { NG: 'Nigeria', AE: 'UAE' };

const projects = [
  {
    id: 1,
    title: "A stunning six-bedroom fully detached duplex",
    owner: "Anaezionwu Jabuike Henry",
    subtitle: "Detached Duplex Design",
    location: "Maitama District, Abuja",
    country: "NG",
    area: "580 M²",
    structure: "Post-Tensioned Concrete Slab",
    timeline: "16 Months (Completed)",
    image: "/assets/real-1.jpeg",
    blueprint: "/assets/3d-3.jpeg",
    description: "This fully detached duplex was designed and built with a modern organic style — maximum glass exposure, deep overhangs for the tropical climate, and a post-tensioned slab that keeps the structure light yet strong.",
    details: [
      { label: "Foundation", value: "Raft Foundation (1.2m Depth)" },
      { label: "Facade", value: "Double Glazed Low-E Glass" },
      { label: "Engineering Standard", value: "Eurocode 2 Compliance" }
    ]
  },
  {
    id: 2,
    title: "A modern luxury villa concept",
    owner: "FURD BASE Design",
    subtitle: "Contemporary Villa Concept",
    location: "CBD, Abuja",
    country: "NG",
    area: "450 M²",
    structure: "Reinforced Concrete Frame",
    timeline: "Concept & Design Phase",
    image: "/assets/3d-2.jpeg",
    blueprint: "/assets/3d-8.jpeg",
    description: "A clean, contemporary villa layout with open living spaces, a wide balcony line, and structural framing designed for easy future expansion. Every line is engineered for both beauty and buildability.",
    details: [
      { label: "Foundation", value: "Raft Foundation" },
      { label: "Ceiling Height", value: "3.8m throughout" },
      { label: "Engineering Standard", value: "Eurocode 2 Compliance" }
    ]
  },
  {
    id: 3,
    title: "A minimalist waterfront residence",
    owner: "Private Client",
    subtitle: "Waterfront Residence Concept",
    location: "Lekki Peninsula, Lagos",
    country: "NG",
    area: "420 M²",
    structure: "Reinforced Concrete Frame",
    timeline: "Concept & Design Phase",
    image: "/assets/3d-6.jpeg",
    blueprint: "/assets/3d-7.jpeg",
    description: "A coastal home designed for a high-saline environment — corrosion-proof reinforcement, deep shaded overhangs, and materials chosen to survive harsh coastal weather for decades.",
    details: [
      { label: "Foundation", value: "Precast Concrete Pile System" },
      { label: "Structural Steel", value: "HDG (Hot-Dip Galvanized)" },
      { label: "Storm Protection", value: "Grade 5 Hurricane Resistance" }
    ]
  },
  {
    id: 4,
    title: "An eco-friendly organic villa",
    owner: "Private Client",
    subtitle: "Eco Villa Concept",
    location: "Maitama Hills, Abuja",
    country: "NG",
    area: "820 M²",
    structure: "Composite Steel-Concrete Frame",
    timeline: "Concept & Design Phase",
    image: "/assets/3d-4.jpeg",
    blueprint: "/assets/3d-5.jpeg",
    description: "A hillside villa with smart ventilation, natural cooling, and a solar-integrated roof. Designed to sit gently on the land while standing strongly for generations.",
    details: [
      { label: "Foundation", value: "Piled Foundation with Ground Beams" },
      { label: "Cantilever Span", value: "4.8m Architectural Projection" },
