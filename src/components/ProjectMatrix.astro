---

<section id="projects" class="py-24 md:py-32 bg-brand-charcoal relative">
  <!-- Grid Accent Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="mb-20 max-w-2xl">
      <span class="font-display text-xs md:text-sm tracking-[0.3em] uppercase text-brand-red font-semibold mb-3 block">
        Our Work
      </span>
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-white tracking-tight uppercase mb-6">
        Some Things We Have Done
      </h2>
      <p class="text-brand-gray font-light text-sm md:text-base">
        A look at some of the homes and developments we have designed and built. Every project is delivered to the same standard — strong structure, careful finishing, and honest engineering.
      </p>
    </div>

    <!-- Case Studies List -->
    <div class="flex flex-col gap-16 md:gap-24">
      {projects.map((project, idx) => (
        <div 
          class={`flex flex-col lg:flex-row gap-8 lg:gap-16 items-stretch`}
          data-id={project.id}
        >
          <!-- Project Info Panel (Left on alternate, right on others) -->
          <div class={`flex-1 flex flex-col justify-between order-2 ${idx % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}`}>
            <div>
              <!-- Project Header -->
              <div class="flex items-center gap-4 mb-4">
                <span class="font-condensed text-5xl font-bold text-brand-red/30">0{project.id}</span>
                <div class="flex-1">
                  <span class="text-xs uppercase tracking-widest text-brand-gray">{project.subtitle}</span>
                  <h3 class="font-serif text-2xl md:text-3xl font-bold text-white mt-0.5">{project.title}</h3>
                  <span class="text-xs text-brand-red mt-1 block font-semibold">Client: {project.owner}</span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/10 bg-brand-dark/60 text-[10px] uppercase tracking-wider font-semibold text-white/70 whitespace-nowrap" set:html={`${flagMap[project.country]} <span class="ml-1.5">${countryNameMap[project.country]}</span>`}>
                </div>
              </div>

              <!-- Case Study Overview -->
              <p class="text-brand-gray text-sm md:text-base font-light leading-relaxed mb-8">
                {project.description}
              </p>

              <!-- Technical Engineering Metrics Table -->
              <div class="border border-white/10 rounded-lg overflow-hidden mb-8">
                <div class="grid grid-cols-2 border-b border-white/5 bg-white/[0.01]">
                  <div class="p-4 border-r border-white/5">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Location</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.location}</span>
                  </div>
                  <div class="p-4">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Gross Area</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.area}</span>
                  </div>
                </div>
                <div class="grid grid-cols-2">
                  <div class="p-4 border-r border-white/5">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Structural Type</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.structure}</span>
                  </div>
                  <div class="p-4">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Timeline</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.timeline}</span>
                  </div>
                </div>
              </div>

              <!-- Details/Structural Spec list -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {project.details.map((detail) => (
                  <div class="bg-brand-dark/40 border border-white/5 p-4 rounded text-left">
                    <span class="block text-[9px] uppercase tracking-wider text-brand-gray mb-1">{detail.label}</span>
                    <span class="text-xs font-medium text-white/90">{detail.value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Image Carousel (Right on alternate, left on others) -->
          <div class={`flex-1 relative rounded-xl overflow-hidden min-h-[350px] md:min-h-[450px] border border-white/10 shadow-xl order-1 ${idx % 2 === 0 ? 'lg:order-2' : 'lg:order-1'} group`}>
            
            <!-- Gallery slides -->
            <div
              class="absolute inset-0 z-0 carousel-track flex transition-transform duration-500 ease-out select-none touch-pan-y cursor-grab active:cursor-grabbing"
              data-track={project.id}
            >
              {project.gallery.map((src, i) => (
                <div class="w-full h-full shrink-0 relative" data-slide={project.id}>
                  <button
                    type="button"
                    class="block w-full h-full cursor-zoom-in open-lightbox"
                    data-gallery={project.id}
                    data-index={i}
                    aria-label={`Open ${project.title} view ${i + 1} fullscreen`}
                  >
                    <img 
                      src={src} 
                      alt={`${project.title} — view ${i + 1}`} 
                      class="w-full h-full object-cover pointer-events-none select-none"
                      draggable="false"
                      loading="lazy"
                    />
                  </button>
                  <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent pointer-events-none"></div>
                </div>
              ))}
            </div>

            <!-- Click hint -->
            <div class="absolute inset-x-0 bottom-16 z-10 flex justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span class="px-3 py-1.5 rounded-full bg-brand-dark/80 backdrop-blur border border-white/10 text-[10px] uppercase tracking-widest text-white/70">
                Click to view fullscreen
              </span>
            </div>

            <!-- Country Flag Badge -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded bg-brand-dark/80 backdrop-blur border border-white/10 text-[10px] uppercase tracking-wider font-semibold text-white/70" set:html={`${flagMap[project.country]} <span class="ml-1.5">${countryNameMap[project.country]}</span>`}>
            </div>

            <!-- Image Counter -->
            <div class="absolute top-4 right-4 z-20 px-2.5 py-1 rounded bg-brand-dark/80 backdrop-blur border border-white/10 text-[10px] uppercase tracking-wider font-semibold text-white/70" data-counter={project.id}>
              <span data-current={project.id}>1</span> / {project.gallery.length}
            </div>

            <!-- Prev / Next Controls -->
            <div class="absolute bottom-4 left-4 right-4 z-20 flex items-center justify-between">
              <button 
                class="carousel-prev w-9 h-9 rounded-full bg-brand-dark/80 hover:bg-brand-red text-white flex items-center justify-center border border-white/10 transition-all"
                data-target={project.id}
                aria-label="Previous image"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
              </button>
              <div class="flex gap-2" data-dots={project.id}>
                {project.gallery.map((_, i) => (
                  <button 
                    class={`carousel-dot w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand-red w-6' : 'bg-white/40'}`}
                    data-target={project.id}
                    data-index={i}
                    aria-label={`Go to image ${i + 1}`}
                  ></button>
                ))}
              </div>
              <button 
                class="carousel-next w-9 h-9 rounded-full bg-brand-dark/80 hover:bg-brand-red text-white flex items-center justify-center border border-white/10 transition-all"
                data-target={project.id}
                aria-label="Next image"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Fullscreen Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur p-4" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button id="lightbox-close" class="absolute top-4 right-4 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-brand-red text-white flex items-center justify-center border border-white/10 transition-colors" aria-label="Close viewer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>

  <span id="lightbox-counter" class="absolute top-5 left-1/2 -translate-x-1/2 z-20 px-3 py-1 rounded-full bg-black/50 border border-white/10 text-xs font-semibold text-white/80"></span>

  <button id="lightbox-prev" class="absolute left-2 md:left-6 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-brand-red text-white flex items-center justify-center border border-white/10 transition-colors" aria-label="Previous image">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
  </button>

  <div class="w-full max-w-6xl h-full flex items-center justify-center">
    <img id="lightbox-img" src="" alt="" class="max-h-full max-w-full object-contain rounded-lg shadow-2xl" />
  </div>

  <button id="lightbox-next" class="absolute right-2 md:right-6 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-brand-red text-white flex items-center justify-center border border-white/10 transition-colors" aria-label="Next image">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
  </button>
</div>

<script>
  // ---- Shared state for carousels + lightbox ----
  const carousels = {}; // id -> { track, slides, total, current, dots, counter, images }
  const lightbox = {
    el: document.getElementById('lightbox'),
    img: document.getElementById('lightbox-img'),
    counter: document.getElementById('lightbox-counter'),
    prev: document.getElementById('lightbox-prev'),
    next: document.getElementById('lightbox-next'),
    close: document.getElementById('lightbox-close'),
    index: 0,
    images: []
  };

  // ---- Carousel swipe + navigation ----
  document.querySelectorAll('[data-track]').forEach(track => {
    const id = track.getAttribute('data-track');
    const slides = Array.from(track.querySelectorAll('[data-slide]'));
    const total = slides.length;
    const prevBtn = document.querySelector(`.carousel-prev[data-target="${id}"]`);
    const nextBtn = document.querySelector(`.carousel-next[data-target="${id}"]`);
    const dots = document.querySelectorAll(`.carousel-dot[data-target="${id}"]`);
    const counter = document.querySelector(`[data-current="${id}"]`);
    const images = slides.map(s => s.querySelector('img').src);
    const state = { current: 0 };
    carousels[id] = { ...state, images, total };

    function goTo(index, animate = true) {
      carousels[id].current = (index + total) % total;
      const current = carousels[id].current;
      track.style.transition = animate ? 'transform 500ms ease-out' : 'none';
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        if (i === current) {
          dot.classList.add('bg-brand-red', 'w-6');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('bg-brand-red', 'w-6');
          dot.classList.add('bg-white/40');
        }
      });
      if (counter) counter.textContent = current + 1;
    }

    // ---- Swipe / drag support ----
    let pointerDownX = null;
    let pointerDownY = null;
    let swiping = false;

    track.addEventListener('pointerdown', (e) => {
      pointerDownX = e.clientX;
      pointerDownY = e.clientY;
      swiping = false;
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener('pointermove', (e) => {
      if (pointerDownX === null) return;
      const dx = e.clientX - pointerDownX;
      const dy = e.clientY - pointerDownY;
      if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
        swiping = true;
        // Follow the pointer for a live drag feel
        track.style.transition = 'none';
        track.style.transform = `translateX(calc(-${carousels[id].current * 100}% + ${dx}px))`;
      }
    });

    track.addEventListener('pointerup', (e) => {
      if (pointerDownX === null) return;
      const dx = e.clientX - pointerDownX;
      pointerDownX = null;
      pointerDownY = null;
      if (swiping) {
        if (dx < -50) goTo(carousels[id].current + 1);
        else if (dx > 50) goTo(carousels[id].current - 1);
        else goTo(carousels[id].current); // snap back
        swiping = false;
      }
    });

    track.addEventListener('pointercancel', (e) => {
      pointerDownX = null;
      pointerDownY = null;
      swiping = false;
      goTo(carousels[id].current);
    });

    // ---- Navigation ----
    prevBtn.addEventListener('click', () => goTo(carousels[id].current - 1));
    nextBtn.addEventListener('click', () => goTo(carousels[id].current + 1));
    dots.forEach(dot => dot.addEventListener('click', () => goTo(parseInt(dot.getAttribute('data-index'), 10))));

    // Keyboard support (when the track is focused via tabbing)
    track.setAttribute('tabindex', '0');
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(carousels[id].current - 1);
      if (e.key === 'ArrowRight') goTo(carousels[id].current + 1);
    });

    // ---- Open lightbox on image click ----
    slides.forEach((slide, i) => {
      const btn = slide.querySelector('.open-lightbox');
      if (btn) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openLightbox(id, i);
        });
      }
    });

    goTo(0);
  });

  // ---- Lightbox ----
  function openLightbox(id, index) {
    const carousel = carousels[id];
    if (!carousel) return;
    lightbox.images = carousel.images.slice();
    lightbox.index = index;
    showLightboxImage(true);
    lightbox.el.classList.remove('hidden');
    lightbox.el.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function showLightboxImage(fast = false) {
    lightbox.img.src = lightbox.images[lightbox.index];
    lightbox.img.alt = `Fullscreen view ${lightbox.index + 1}`;
    lightbox.counter.textContent = `${lightbox.index + 1} / ${lightbox.images.length}`;
  }

  function closeLightbox() {
    lightbox.el.classList.add('hidden');
    lightbox.el.classList.remove('flex');
    document.body.style.overflow = '';
  }

  lightbox.prev.addEventListener('click', () => {
    lightbox.index = (lightbox.index - 1 + lightbox.images.length) % lightbox.images.length;
    showLightboxImage();
  });
  lightbox.next.addEventListener('click', () => {
    lightbox.index = (lightbox.index + 1) % lightbox.images.length;
    showLightboxImage();
  });
  lightbox.close.addEventListener('click', closeLightbox);

  // Close on backdrop click (outside the image)
  lightbox.el.addEventListener('click', (e) => {
    if (e.target.id === 'lightbox') closeLightbox();
  });

  // Keyboard: arrows navigate, Escape closes
  document.addEventListener('keydown', (e) => {
    const isOpen = !lightbox.el.classList.contains('hidden');
    if (isOpen) {
      if (e.key === 'ArrowLeft') lightbox.prev.click();
      else if (e.key === 'ArrowRight') lightbox.next.click();
      else if (e.key === 'Escape') closeLightbox();
      e.stopPropagation();
    }
  });
</script>
