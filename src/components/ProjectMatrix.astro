---

<section id="projects" class="py-24 md:py-32 bg-brand-charcoal relative">
  <!-- Grid Accent Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="mb-20 max-w-2xl">
      <span class="font-display text-xs md:text-sm tracking-[0.3em] uppercase text-brand-red font-semibold mb-3 block">
        Our Work
      </span>
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-white tracking-tight uppercase mb-6">
        Some Things We Have Done
      </h2>
      <p class="text-brand-gray font-light text-sm md:text-base">
        A look at some of the homes and developments we have designed and built. Every project is delivered to the same standard — strong structure, careful finishing, and honest engineering.
      </p>
    </div>

    <!-- Case Studies List -->
    <div class="flex flex-col gap-16 md:gap-24">
      {projects.map((project, idx) => (
        <div 
          class={`flex flex-col lg:flex-row gap-8 lg:gap-16 items-stretch case-study-row`}
          data-id={project.id}
        >
          <!-- Project Info Panel (Left on alternate, right on others) -->
          <div class={`flex-1 flex flex-col justify-between order-2 ${idx % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}`}>
            <div>
              <!-- Project Header -->
              <div class="flex items-center gap-4 mb-4">
                <span class="font-condensed text-5xl font-bold text-brand-red/30">0{project.id}</span>
                <div class="flex-1">
                  <span class="text-xs uppercase tracking-widest text-brand-gray">{project.subtitle}</span>
                  <h3 class="font-serif text-2xl md:text-3xl font-bold text-white mt-0.5">{project.title}</h3>
                  <span class="text-xs text-brand-red mt-1 block font-semibold">Client: {project.owner}</span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded border border-white/10 bg-brand-dark/60 text-[10px] uppercase tracking-wider font-semibold text-white/70 whitespace-nowrap" set:html={`${flagMap[project.country]} <span class="ml-1.5">${countryNameMap[project.country]}</span>`}>
                </div>
              </div>

              <!-- Case Study Overview -->
              <p class="text-brand-gray text-sm md:text-base font-light leading-relaxed mb-8">
                {project.description}
              </p>

              <!-- Technical Engineering Metrics Table (Requested) -->
              <div class="border border-white/10 rounded-lg overflow-hidden mb-8">
                <div class="grid grid-cols-2 border-b border-white/5 bg-white/[0.01]">
                  <div class="p-4 border-r border-white/5">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Location</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.location}</span>
                  </div>
                  <div class="p-4">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Gross Area</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.area}</span>
                  </div>
                </div>
                <div class="grid grid-cols-2">
                  <div class="p-4 border-r border-white/5">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Structural Type</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.structure}</span>
                  </div>
                  <div class="p-4">
                    <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Timeline</span>
                    <span class="font-sans font-semibold text-white text-sm">{project.timeline}</span>
                  </div>
                </div>
              </div>

              <!-- Details/Structural Spec list -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {project.details.map((detail) => (
                  <div class="bg-brand-dark/40 border border-white/5 p-4 rounded text-left">
                    <span class="block text-[9px] uppercase tracking-wider text-brand-gray mb-1">{detail.label}</span>
                    <span class="text-xs font-medium text-white/90">{detail.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Action Button -->
            <div class="mt-10">
              <button 
                class="view-details-btn inline-flex items-center gap-3 text-xs uppercase tracking-widest font-semibold text-white hover:text-brand-red transition-colors duration-300"
                data-target={project.id}
              >
                See Design Details
                <span class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center hover:border-brand-red transition-all">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <!-- Image / Interactive Tab Display (Right on alternate, left on others) -->
          <div class={`flex-1 relative rounded-xl overflow-hidden min-h-[350px] md:min-h-[450px] border border-white/10 shadow-xl order-1 ${idx % 2 === 0 ? 'lg:order-2' : 'lg:order-1'} group`}>
            
            <!-- Default Render Image -->
            <div class="absolute inset-0 z-0 transition-transform duration-700 group-hover:scale-105" id={`render-img-${project.id}`}>
              <img 
                src={project.image} 
                alt={project.title} 
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent"></div>
            </div>

            <!-- Technical Detail Overlay (revealed on button toggle) -->
            <div 
              class="absolute inset-0 z-10 bg-brand-dark/95 flex flex-col justify-between p-6 opacity-0 pointer-events-none transition-all duration-500 transform translate-y-4"
              id={`blueprint-panel-${project.id}`}
            >
              <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <h4 class="font-serif text-lg font-bold text-white uppercase tracking-wider">Design Details</h4>
                <button 
                  class="close-blueprint-btn text-brand-gray hover:text-white"
                  data-target={project.id}
                >
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>
              </div>

              <!-- Blueprint / structural mockup image -->
              <div class="flex-1 my-4 rounded border border-white/5 overflow-hidden bg-brand-charcoal relative">
                <img 
                  src={project.blueprint} 
                  alt="Technical Blueprint" 
                  class="w-full h-full object-cover mix-blend-lighten opacity-80 filter grayscale sepia hue-rotate-[190deg] saturate-200"
                />
              </div>

              <div class="text-xs text-brand-gray flex justify-between">
                <span>Drawing Ref: FB-DET-{project.id}04</span>
                <span>Scale: 1:150 @ A3</span>
              </div>
            </div>
            
            <!-- Country Flag Badge on Image -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded bg-brand-dark/80 backdrop-blur border border-white/10 text-[10px] uppercase tracking-wider font-semibold text-white/70" set:html={`${flagMap[project.country]} <span class="ml-1.5">${countryNameMap[project.country]}</span>`}>
            </div>

            <!-- Quick View Toggle Buttons -->
            <div class="absolute top-4 right-4 z-20 flex gap-2">
              <button 
                class="img-mode-btn bg-brand-dark/80 hover:bg-brand-red text-white text-[10px] uppercase font-bold tracking-widest px-3 py-1.5 rounded backdrop-blur border border-white/10 active-btn"
                data-id={project.id}
                data-mode="render"
              >
                Design
              </button>
              <button 
                class="img-mode-btn bg-brand-dark/80 hover:bg-brand-red text-white text-[10px] uppercase font-bold tracking-widest px-3 py-1.5 rounded backdrop-blur border border-white/10"
                data-id={project.id}
                data-mode="blueprint"
              >
                Blueprint
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .active-btn {
    background-color: var(--color-brand-red) !important;
    border-color: var(--color-brand-red) !important;
  }
</style>

<script>
  // Add interactive display controls for renders vs structural blueprints
  const viewDetailBtns = document.querySelectorAll('.view-details-btn');
  const closeBlueprintBtns = document.querySelectorAll('.close-blueprint-btn');
  const imgModeBtns = document.querySelectorAll('.img-mode-btn');

  // Toggle blueprint panel
  viewDetailBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const panel = document.getElementById(`blueprint-panel-${targetId}`);
      if (panel) {
        panel.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        panel.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    });
  });

  closeBlueprintBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const panel = document.getElementById(`blueprint-panel-${targetId}`);
      if (panel) {
        panel.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        panel.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    });
  });

  // Tab controls for Render / Structural Detail button triggers
  imgModeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const mode = btn.getAttribute('data-mode');
      const panel = document.getElementById(`blueprint-panel-${id}`);
      
      // Update button highlights
      const rowButtons = document.querySelectorAll(`.img-mode-btn[data-id="${id}"]`);
      rowButtons.forEach(b => b.classList.remove('active-btn'));
      btn.classList.add('active-btn');

      if (panel) {
        if (mode === 'blueprint') {
          panel.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
          panel.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        } else {
          panel.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
          panel.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        }
      }
    });
  });
</script>
