---
// ContactSection.astro
---
<section id="contact" class="py-24 md:py-32 bg-brand-dark relative overflow-hidden">
  <!-- Accent Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-red/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 items-start">
      
      <!-- Info Column -->
      <div class="flex-1 max-w-lg">
        <span class="font-display text-xs md:text-sm tracking-[0.3em] uppercase text-brand-red font-semibold mb-3 block">
          Get In Touch
        </span>
        <h2 class="font-serif text-4xl md:text-5xl font-bold text-white tracking-tight uppercase mb-8">
          Build the Vision
        </h2>
        <p class="text-brand-gray font-light text-sm md:text-base leading-relaxed mb-12">
          Ready to initiate your development? Select your intent, fill out the design parameters, and our engineering team will route your inquiry immediately. You can choose to save to our database or start an instant WhatsApp consultation.
        </p>

        <!-- Structured Contact info -->
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-red">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Main Office <span class="inline-block ml-1.5"><svg class="inline-block w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="3.33" height="7" fill="#008751"/><rect x="6.67" width="3.33" height="7" fill="#008751"/></svg></span></span>
              <span class="text-sm font-semibold text-white">Maitama District, Abuja, Nigeria</span>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-red">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-brand-gray tracking-wider">Dubai Office <span class="inline-block ml-1.5"><svg class="inline-block w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="10" height="2.33" fill="#00732f"/><rect y="4.67" width="10" height="2.33" fill="#000"/><rect width="2.5" height="7" fill="#ce1127"/></svg></span></span>
              <span class="text-sm font-semibold text-white">Dubai, United Arab Emirates</span>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-red">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.022-.08-.124-.22-.364-.34-.24-.12-1.418-.7-1.638-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-.992-.367-1.89-1.166-.7-.624-1.171-1.396-1.309-1.637-.14-.24-.015-.369.106-.488.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.195-.47-.393-.407-.54-.415-.14-.008-.31-.008-.47-.008a.9.9 0 00-.66.3c-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.09 3.62.572.247 1.018.395 1.365.505.61.194 1.164.167 1.6.102.487-.072 1.418-.58 1.618-1.14.2-.56.2-1.04.14-1.14-.06-.1-.2-.16-.44-.28zM12 2C6.477 2 2 6.477 2 12c0 2.01.593 3.88 1.61 5.45L2.03 22l4.685-1.543c1.5.894 3.256 1.41 5.285 1.41 5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.85 0-3.56-.54-5-1.46l-.36-.21-2.92.96.98-2.84-.25-.39C3.54 14.64 3 12.87 3 11c0-4.97 4.03-9 9-9s9 4.03 9 9-4.03 9-9 9z"/>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-brand-gray tracking-wider">WhatsApp Direct</span>
              <a
                href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_PHONE || '2348066033786'}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-white hover:text-brand-red transition-colors"
              >
                +234 806 603 3786
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-brand-red">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <span class="block text-[10px] uppercase text-brand-gray tracking-wider">LinkedIn</span>
              <a
                href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/'}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-white hover:text-brand-red transition-colors"
              >
                /company/furdbase
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Funnel Form Column -->
      <div class="flex-1 w-full bg-brand-charcoal/80 border border-white/10 p-8 rounded-2xl backdrop-blur red-glow">
        <form id="funnel-form" class="space-y-6">
          
          <!-- Name Input -->
          <div>
            <label for="name" class="block text-xs uppercase tracking-widest text-brand-gray mb-2 font-semibold">Your Name</label>
            <input 
              type="text" 
              id="name" 
              required
              placeholder="e.g. Your Full Name"
              class="w-full bg-brand-dark/50 border border-white/15 focus:border-brand-red text-white text-sm px-4 py-3 rounded-lg focus:outline-none transition-colors"
            />
          </div>

          <!-- Phone Input (WhatsApp) -->
          <div>
            <label for="phone" class="block text-xs uppercase tracking-widest text-brand-gray mb-2 font-semibold">WhatsApp Number</label>
            <input 
              type="tel" 
              id="phone" 
              required
              placeholder="e.g. +234 810 000 0000"
              class="w-full bg-brand-dark/50 border border-white/15 focus:border-brand-red text-white text-sm px-4 py-3 rounded-lg focus:outline-none transition-colors"
            />
          </div>

          <!-- Intent selector (Capsule Style radio buttons) -->
          <div>
            <label class="block text-xs uppercase tracking-widest text-brand-gray mb-3 font-semibold">Select Partnership Intent</label>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3" id="intent-selector">
              <label class="cursor-pointer">
                <input type="radio" name="intent" value="Architectural Design" checked class="sr-only peer" />
                <div class="border border-white/15 peer-checked:border-brand-red peer-checked:bg-brand-red/10 text-center py-3 rounded-lg text-xs font-semibold uppercase tracking-wider text-white hover:border-white/40 transition-all">
                  Architecture
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intent" value="Civil Engineering Consultation" class="sr-only peer" />
                <div class="border border-white/15 peer-checked:border-brand-red peer-checked:bg-brand-red/10 text-center py-3 rounded-lg text-xs font-semibold uppercase tracking-wider text-white hover:border-white/40 transition-all">
                  Engineering
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="intent" value="Property Investment" class="sr-only peer" />
                <div class="border border-white/15 peer-checked:border-brand-red peer-checked:bg-brand-red/10 text-center py-3 rounded-lg text-xs font-semibold uppercase tracking-wider text-white hover:border-white/40 transition-all">
                  Investment
                </div>
              </label>
            </div>
          </div>

          <!-- Brief Parameters / Message -->
          <div>
            <label for="message" class="block text-xs uppercase tracking-widest text-brand-gray mb-2 font-semibold">Development Parameters</label>
            <textarea 
              id="message" 
              rows="3"
              placeholder="Tell us about the project (location, dimensions, timeline)..."
              class="w-full bg-brand-dark/50 border border-white/15 focus:border-brand-red text-white text-sm px-4 py-3 rounded-lg focus:outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <!-- Submit Database -->
            <button 
              type="submit" 
              class="flex-1 py-4 bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold uppercase tracking-widest rounded-lg transition-colors shadow-lg active:scale-[0.98]"
            >
              Submit Inquiry
            </button>
            
            <!-- WhatsApp Route Button -->
            <button 
              type="button"
              id="whatsapp-route-btn" 
              class="flex-1 py-4 bg-transparent border border-white/20 hover:border-emerald-500 hover:bg-emerald-500/10 text-white hover:text-emerald-400 text-xs font-bold uppercase tracking-widest rounded-lg transition-all flex items-center justify-center gap-2 active:scale-[0.98]"
            >
              <!-- WhatsApp Icon SVG -->
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.022-.08-.124-.22-.364-.34-.24-.12-1.418-.7-1.638-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-.992-.367-1.89-1.166-.7-.624-1.171-1.396-1.309-1.637-.14-.24-.015-.369.106-.488.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.195-.47-.393-.407-.54-.415-.14-.008-.31-.008-.47-.008a.9.9 0 00-.66.3c-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.09 3.62.572.247 1.018.395 1.365.505.61.194 1.164.167 1.6.102.487-.072 1.418-.58 1.618-1.14.2-.56.2-1.04.14-1.14-.06-.1-.2-.16-.44-.28zM12 2C6.477 2 2 6.477 2 12c0 2.01.593 3.88 1.61 5.45L2.03 22l4.685-1.543c1.5.894 3.256 1.41 5.285 1.41 5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.85 0-3.56-.54-5-1.46l-.36-.21-2.92.96.98-2.84-.25-.39C3.54 14.64 3 12.87 3 11c0-4.97 4.03-9 9-9s9 4.03 9 9-4.03 9-9 9z"/>
              </svg>
              WhatsApp Route
            </button>
          </div>

        </form>
        
        <!-- Status Toast (Hidden by default) -->
        <div id="status-toast" class="mt-4 p-4 rounded text-center text-xs font-semibold tracking-wider hidden"></div>
      </div>

    </div>
  </div>
</section>

<script>
  // Simple inquiry submission and WhatsApp router logic
  const form = document.getElementById('funnel-form') as HTMLFormElement;
  const whatsappBtn = document.getElementById('whatsapp-route-btn');
  const toast = document.getElementById('status-toast');

  const WHATSAPP_PHONE = import.meta.env.PUBLIC_WHATSAPP_PHONE || '2348066033786';
  const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID || '';

  function showToast(message: string, isError = false) {
    if (!toast) return;
    toast.innerText = message;
    toast.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-400', 'bg-red-500/10', 'text-red-400');
    if (isError) {
      toast.classList.add('bg-red-500/10', 'text-red-400');
    } else {
      toast.classList.add('bg-emerald-500/10', 'text-emerald-400');
    }
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 4000);
  }

  // Get current form data
  function getFormData() {
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    const msgInput = document.getElementById('message') as HTMLTextAreaElement;
    const intentActive = document.querySelector('input[name="intent"]:checked') as HTMLInputElement;

    return {
      name: nameInput?.value || '',
      phone: phoneInput?.value || '',
      intent: intentActive?.value || 'Architectural Design',
      message: msgInput?.value || ''
    };
  }

  // Standard Database submit route (Formspree)
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = getFormData();

    if (!FORMSPREE_ID) {
      showToast('Form service not configured. Please contact us directly via WhatsApp.', true);
      return;
    }

    try {
      const response = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        showToast(`Thank you, ${data.name}. Your inquiry has been submitted successfully!`);
        form.reset();
      } else {
        showToast('Submission failed. Please try again or use WhatsApp.', true);
      }
    } catch {
      showToast('Network error. Please try again or use WhatsApp.', true);
    }
  });

  // Dynamic WhatsApp routing
  whatsappBtn?.addEventListener('click', () => {
    const data = getFormData();
    
    // Validate required fields
    if (!data.name || !data.phone) {
      showToast('Please fill out your Name and WhatsApp Number first.', true);
      return;
    }

    // Format WhatsApp message text
    const textMessage = `Hello FURD BASE,%0A%0AI would like to start a consultation.%0A%0A*Name:* ${encodeURIComponent(data.name)}%0A*Phone:* ${encodeURIComponent(data.phone)}%0A*Partnership Intent:* ${encodeURIComponent(data.intent)}%0A*Details:* ${encodeURIComponent(data.message || 'No additional details provided.')}%0A%0APlease let me know your availability.`;

    // Construct link and route
    const waLink = `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${textMessage}`;
    
    // Open in a new window/tab
    window.open(waLink, '_blank');
    showToast('Redirecting to WhatsApp consultation...');
  });
</script>
