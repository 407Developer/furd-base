---
// Header.astro
---
<header id="main-header" class="fixed top-0 left-0 z-[70] w-full border-b border-white/[0.03] transition-all duration-500">
  <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
    <!-- Logo -->
    <a id="header-brand" href="/" class="flex items-center gap-3 group transition-opacity duration-200">
      <img 
        src="/assets/FURD-BASE-main-logo.png" 
        alt="FURD BASE Logo" 
        class="h-12 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="font-serif tracking-[0.2em] text-lg font-bold leading-none text-white">FURD BASE</span>
        <span class="font-sans text-[9px] tracking-[0.3em] uppercase text-brand-red font-medium mt-1 flex items-center gap-1.5">
          <svg class="w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="3.33" height="7" fill="#008751"/><rect x="6.67" width="3.33" height="7" fill="#008751"/></svg>
          Nigeria
          <span class="text-white/20 mx-0.5">|</span>
          <svg class="w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="10" height="2.33" fill="#00732f"/><rect y="4.67" width="10" height="2.33" fill="#000"/><rect width="2.5" height="7" fill="#ce1127"/></svg>
          UAE
        </span>
      </div>
    </a>

    <!-- Navigation (Desktop) -->
    <nav class="hidden md:flex items-center gap-10 font-display text-sm tracking-wider uppercase">
      <a href="/" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="home">
        Home
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/#showcase" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="showcase">
        Showcase
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/#projects" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="projects">
        Projects
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/about" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="about">
        About
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/services" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="services">
        Services
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/blog" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="journal">
        Journal
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/#contact" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300" data-nav="contact">
        Contact
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
    </nav>

    <!-- CTAs -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/in/jabuike-aneazionwu-b54196418/'}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-brand-red hover:bg-brand-red/10 transition-all duration-300 group"
        aria-label="LinkedIn"
      >
        <svg class="w-4 h-4 text-white/70 group-hover:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a
        href={import.meta.env.PUBLIC_FACEBOOK_URL || 'https://www.facebook.com/1143285678875417'}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-brand-red hover:bg-brand-red/10 transition-all duration-300 group"
        aria-label="Facebook"
      >
        <svg class="w-4 h-4 text-white/70 group-hover:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <a
        href={import.meta.env.PUBLIC_INSTAGRAM_URL || 'https://www.instagram.com/furd_base_limited'}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-brand-red hover:bg-brand-red/10 transition-all duration-300 group"
        aria-label="Instagram"
      >
        <svg class="w-4 h-4 text-white/70 group-hover:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
      <a 
        href="/#contact" 
        class="relative inline-flex items-center justify-center px-6 py-3 rounded-full text-xs font-semibold uppercase tracking-widest text-white border border-white/20 overflow-hidden group transition-all duration-300 hover:border-brand-red"
      >
        <span class="absolute inset-0 bg-brand-red scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100 -z-10"></span>
        Consult Now
      </a>
    </div>

    <!-- Mobile Trigger -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-1.5 focus:outline-none relative z-[70]"
      aria-label="Toggle Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
    </button>
  </div>
</header>

  <!-- Mobile Overlay -->
  <div id="mobile-menu" class="fixed inset-0 z-[60] flex min-h-[100dvh] flex-col overflow-y-auto overscroll-contain bg-brand-dark/98 px-6 pb-10 pt-28 opacity-0 pointer-events-none translate-x-full transition-[transform,opacity] duration-300 ease-out md:hidden sm:px-12" aria-hidden="true">
    <nav class="flex max-w-sm flex-col gap-1 text-[1.7rem] font-serif tracking-wide text-white" aria-label="Mobile navigation">
      <a href="/" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Home</a>
      <a href="/#showcase" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Showcase</a>
      <a href="/#projects" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Projects</a>
      <a href="/about" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">About</a>
      <a href="/services" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Services</a>
      <a href="/blog" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Journal</a>
      <a href="/#contact" class="mobile-nav-link border-b border-white/10 py-3 hover:text-brand-red transition-colors">Contact</a>
    </nav>
    <div class="mt-8">
      <a
        href="/#contact"
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-red px-7 py-3 text-center text-sm font-semibold uppercase tracking-widest text-white transition-all duration-300 hover:bg-brand-red-dark"
      >
        Get A Consultation
      </a>
    </div>
  </div>

  <!-- Floating WhatsApp Contact -->
  <a
    id="floating-whatsapp"
    href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP_PHONE || '2348066033786'}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
    class="fixed z-[50] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg shadow-black/40 transition-[transform,opacity] duration-300 hover:scale-110 group"
  >
    <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.022-.08-.124-.22-.364-.34-.24-.12-1.418-.7-1.638-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-.992-.367-1.89-1.166-.7-.624-1.171-1.396-1.309-1.637-.14-.24-.015-.369.106-.488.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.195-.47-.393-.407-.54-.415-.14-.008-.31-.008-.47-.008a.9.9 0 00-.66.3c-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.69 2.58 4.09 3.62.572.247 1.018.395 1.365.505.61.194 1.164.167 1.6.102.487-.072 1.418-.58 1.618-1.14.2-.56.2-1.04.14-1.14-.06-.1-.2-.16-.44-.28zM12 2C6.477 2 2 6.477 2 12c0 2.01.593 3.88 1.61 5.45L2.03 22l4.685-1.543c1.5.894 3.256 1.41 5.285 1.41 5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.85 0-3.56-.54-5-1.46l-.36-.21-2.92.96.98-2.84-.25-.39C3.54 14.64 3 12.87 3 11c0-4.97 4.03-9 9-9s9 4.03 9 9-4.03 9-9 9z"/>
    </svg>
  </a>
<style>
  .nav-link:hover .nav-indicator {
    transform: scale-x(1);
    transform-origin: left;
  }
  
  /* Scroll state class added via JS */
  .header-scrolled {
    background-color: rgba(7, 7, 8, 0.85);
    backdrop-filter: blur(16px);
    height: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  .header-scrolled .max-w-7xl {
    height: 80px;
  }

  #floating-whatsapp {
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
  }
</style>

<script>
  // Sticky scroll effect
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  });

  // Mobile Menu logic
  const headerBrand = document.getElementById('header-brand');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const floatingWhatsapp = document.getElementById('floating-whatsapp');
  const burgerLines = document.querySelectorAll('.burger-line');
  const mobileLinks = document.querySelectorAll('#mobile-menu a');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen ? closeMenu() : openMenu();
  }

  function openMenu() {
    isMenuOpen = true;
    mobileMenu?.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
    mobileMenu?.classList.add('translate-x-0', 'opacity-100');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuToggle?.setAttribute('aria-expanded', 'true');
    headerBrand?.classList.add('opacity-0', 'pointer-events-none');
    floatingWhatsapp?.classList.add('opacity-0', 'pointer-events-none');
    floatingWhatsapp?.setAttribute('aria-hidden', 'true');
    floatingWhatsapp?.setAttribute('tabindex', '-1');
    burgerLines[0].classList.add('rotate-45', 'translate-y-[7px]');
    burgerLines[1].classList.add('opacity-0');
    burgerLines[2].classList.add('-rotate-45', '-translate-y-[7px]');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    isMenuOpen = false;
    mobileMenu?.classList.remove('translate-x-0', 'opacity-100');
    mobileMenu?.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuToggle?.setAttribute('aria-expanded', 'false');
    headerBrand?.classList.remove('opacity-0', 'pointer-events-none');
    floatingWhatsapp?.classList.remove('opacity-0', 'pointer-events-none');
    floatingWhatsapp?.setAttribute('aria-hidden', 'false');
    floatingWhatsapp?.removeAttribute('tabindex');
    burgerLines[0].classList.remove('rotate-45', 'translate-y-[7px]');
    burgerLines[1].classList.remove('opacity-0');
    burgerLines[2].classList.remove('-rotate-45', '-translate-y-[7px]');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });

  // Close when tapping anywhere on the overlay that isn't a link/button
  mobileMenu?.addEventListener('click', (e) => {
    if (isMenuOpen && (e.target as HTMLElement)?.closest('a,button')) return;
    if (isMenuOpen) closeMenu();
  });

  // Close with the Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) closeMenu();
  });

  // ── Active nav state ──
  const navLinks = document.querySelectorAll<HTMLElement>('[data-nav]');

  function setActive(navKey: string | null) {
    navLinks.forEach(link => {
      const isActive = link.dataset.nav === navKey;
      link.classList.toggle('text-white', isActive);
      link.classList.toggle('text-white/70', !isActive);
      const indicator = link.querySelector('.nav-indicator');
      if (indicator) {
        indicator.style.transform = isActive ? 'scale-x(1)' : 'scale-x(0)';
        if (isActive) indicator.style.transformOrigin = 'left';
      }
    });
  }

  const path = window.location.pathname.replace(/\/$/, '') || '/';
  const pageNav: Record<string, string> = {
    '/': 'home',
    '/about': 'about',
    '/services': 'services',
    '/blog': 'journal',
  };
  const currentPageNav = Object.entries(pageNav).find(([p]) => path.startsWith(p))?.[1] || null;

  // On the homepage, scroll-spy the section links; elsewhere just highlight the current page.
  if (currentPageNav === 'home') {
    setActive('home');
    const sectionIds = ['showcase', 'projects', 'contact'];
    const sectionEls = sectionIds
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    sectionEls.forEach(el => spy.observe(el));
  } else {
    setActive(currentPageNav);
  }

</script>
