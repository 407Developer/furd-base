---
// Header.astro
---
<header id="main-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-500 border-b border-white/[0.03]">
  <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <img 
        src="/assets/FURD-BASE-main-logo.png" 
        alt="FURD BASE Logo" 
        class="h-12 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="font-serif tracking-[0.2em] text-lg font-bold leading-none text-white">FURD BASE</span>
        <span class="font-sans text-[9px] tracking-[0.3em] uppercase text-brand-red font-medium mt-1 flex items-center gap-1.5">
          <svg class="w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="3.33" height="7" fill="#008751"/><rect x="6.67" width="3.33" height="7" fill="#008751"/></svg>
          Nigeria
          <span class="text-white/20 mx-0.5">|</span>
          <svg class="w-3.5 h-2.5 rounded-[1px]" viewBox="0 0 10 7" xmlns="http://www.w3.org/2000/svg"><rect width="10" height="7" fill="#fff"/><rect width="10" height="2.33" fill="#00732f"/><rect y="4.67" width="10" height="2.33" fill="#000"/><rect width="2.5" height="7" fill="#ce1127"/></svg>
          UAE
        </span>
      </div>
    </a>

    <!-- Navigation (Desktop) -->
    <nav class="hidden md:flex items-center gap-10 font-display text-sm tracking-wider uppercase">
      <a href="/" class="nav-link relative py-2 text-white hover:text-white transition-colors duration-300">
        Home
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/#showcase" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        Showcase
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="#projects" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        Projects
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/about" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        About
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/services" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        Services
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="/blog" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        Journal
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
      <a href="#contact" class="nav-link relative py-2 text-white/70 hover:text-white transition-colors duration-300">
        Contact
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-brand-red scale-x-0 origin-right transition-transform duration-350 ease-out nav-indicator"></span>
      </a>
    </nav>

    <!-- CTAs -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/'}
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-brand-red hover:bg-brand-red/10 transition-all duration-300 group"
        aria-label="LinkedIn"
      >
        <svg class="w-4 h-4 text-white/70 group-hover:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a 
        href="#contact" 
        class="relative inline-flex items-center justify-center px-6 py-3 rounded-full text-xs font-semibold uppercase tracking-widest text-white border border-white/20 overflow-hidden group transition-all duration-300 hover:border-brand-red"
      >
        <span class="absolute inset-0 bg-brand-red scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100 -z-10"></span>
        Consult Now
      </a>
    </div>

    <!-- Mobile Trigger -->
    <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 focus:outline-none" aria-label="Toggle Menu">
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
      <span class="w-6 h-[2px] bg-white transition-all duration-300 burger-line"></span>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-brand-dark/98 z-[45] flex flex-col justify-center px-12 md:hidden translate-x-full transition-transform duration-500 ease-in-out">
    <nav class="flex flex-col gap-8 text-3xl font-serif tracking-wide text-white">
      <a href="#" class="mobile-nav-link hover:text-brand-red transition-colors">Home</a>
      <a href="/about" class="mobile-nav-link hover:text-brand-red transition-colors">About</a>
      <a href="/services" class="mobile-nav-link hover:text-brand-red transition-colors">Services</a>
      <a href="/blog" class="mobile-nav-link hover:text-brand-red transition-colors">Journal</a>
      <a href="#showcase" class="mobile-nav-link hover:text-brand-red transition-colors">Showcase</a>
      <a href="#projects" class="mobile-nav-link hover:text-brand-red transition-colors">Projects</a>
      <a href="#contact" class="mobile-nav-link hover:text-brand-red transition-colors">Contact</a>
    </nav>
    <div class="mt-12">
      <a 
        href="#contact" 
        class="inline-block px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white text-sm font-semibold uppercase tracking-widest rounded-full text-center transition-all duration-300"
      >
        Get A Consultation
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link:hover .nav-indicator {
    transform: scale-x(1);
    transform-origin: left;
  }
  
  /* Scroll state class added via JS */
  .header-scrolled {
    background-color: rgba(7, 7, 8, 0.85);
    backdrop-filter: blur(16px);
    height: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  
  .header-scrolled .max-w-7xl {
    height: 80px;
  }
</style>

<script>
  // Sticky scroll effect
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  });

  // Mobile Menu logic
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const burgerLines = document.querySelectorAll('.burger-line');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      mobileMenu?.classList.remove('translate-x-full');
      burgerLines[0].classList.add('rotate-45', 'translate-y-[7px]');
      burgerLines[1].classList.add('opacity-0');
      burgerLines[2].classList.add('-rotate-45', '-translate-y-[7px]');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu?.classList.add('translate-x-full');
      burgerLines[0].classList.remove('rotate-45', 'translate-y-[7px]');
      burgerLines[1].classList.remove('opacity-0');
      burgerLines[2].classList.remove('-rotate-45', '-translate-y-[7px]');
      document.body.style.overflow = '';
    }
  }

  menuToggle?.addEventListener('click', toggleMenu);
  
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });
</script>
