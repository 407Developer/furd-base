---
import Header from '../components/Header.astro';
import '../styles/global.css';

const formspreeId = 'xaqrvyrw'; // Formspree endpoint
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | FURD BASE</title>
  </head>
  <body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 flex items-center justify-center px-6 py-32">
      <div class="w-full max-w-lg">
        <div class="text-center mb-12">
          <span class="font-display text-xs tracking-[0.3em] uppercase text-brand-red font-semibold mb-3 block">
            Blog Control
          </span>
          <h1 class="font-serif text-3xl md:text-4xl font-bold text-white tracking-tight uppercase mb-4">
            New Article
          </h1>
          <p class="text-brand-gray text-sm font-light leading-relaxed">
            Submit a topic. The article will be drafted, reviewed, and published to <strong class="text-white">furdbase.com/blog</strong>.
          </p>
        </div>

        <form id="topic-form" action={`https://formspree.io/f/${formspreeId}`} method="POST" class="space-y-6">
          <div>
            <label for="topic" class="block text-[10px] uppercase tracking-widest text-brand-gray mb-2">Article Topic</label>
            <input
              type="text"
              id="topic"
              name="topic"
              required
              placeholder="e.g. How to choose the right architect in Abuja"
              class="w-full bg-brand-charcoal border border-white/10 rounded-lg px-4 py-3.5 text-white text-sm font-light placeholder:text-white/20 focus:outline-none focus:border-brand-red/50 transition-colors"
            />
          </div>

          <div>
            <label for="notes" class="block text-[10px] uppercase tracking-widest text-brand-gray mb-2">Notes (optional)</label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              placeholder="Any specific angles, keywords, or details to include..."
              class="w-full bg-brand-charcoal border border-white/10 rounded-lg px-4 py-3.5 text-white text-sm font-light placeholder:text-white/20 focus:outline-none focus:border-brand-red/50 transition-colors resize-none"
            ></textarea>
          </div>

          <div>
            <label for="image-prompt" class="block text-[10px] uppercase tracking-widest text-brand-gray mb-2">Image Prompt (optional)</label>
            <input
              type="text"
              id="image-prompt"
              name="image-prompt"
              placeholder="Describe the image you'll generate for this post"
              class="w-full bg-brand-charcoal border border-white/10 rounded-lg px-4 py-3.5 text-white text-sm font-light placeholder:text-white/20 focus:outline-none focus:border-brand-red/50 transition-colors"
            />
          </div>

          <input type="hidden" name="_subject" value="New Blog Topic — FURD BASE" />
          <input type="hidden" name="_template" value="table" />

          <button
            type="submit"
            class="w-full bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold uppercase tracking-widest py-4 rounded-lg transition-all duration-300"
          >
            Submit Topic
          </button>
        </form>

        <div id="success-message" class="hidden text-center py-16">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-brand-red/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h2 class="font-serif text-2xl font-bold text-white mb-2">Topic Submitted</h2>
          <p class="text-brand-gray text-sm font-light">Your article will be drafted and ready for review shortly.</p>
          <button
            id="submit-another"
            class="mt-8 px-6 py-3 border border-white/20 text-white text-xs uppercase tracking-widest rounded-full hover:border-brand-red hover:text-brand-red transition-colors"
          >
            Submit Another
          </button>
        </div>

        <div class="mt-12 text-center">
          <p class="text-brand-gray/50 text-[10px] uppercase tracking-widest">
            Or send a topic directly via WhatsApp or message
          </p>
        </div>
      </div>
    </main>

    <script>
      const form = document.getElementById('topic-form') as HTMLFormElement;
      const successMessage = document.getElementById('success-message');
      const submitAnother = document.getElementById('submit-another');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });

          if (response.ok) {
            form.style.display = 'none';
            successMessage?.classList.remove('hidden');
          }
        } catch (error) {
          alert('Something went wrong. Please try again.');
        }
      });

      submitAnother?.addEventListener('click', () => {
        form?.reset();
        form.style.display = '';
        successMessage?.classList.add('hidden');
      });
    </script>
  </body>
</html>
