---
import Header from '../components/Header.astro';
import ContactSection from '../components/ContactSection.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href="https://furdbase.com/about" />
    <title>About | FURD BASE Architecture & Engineering</title>
    <meta name="description" content="FURD BASE is Abuja's premier architecture, civil engineering, and real estate development firm. Learn our story, mission, and approach." />
    <meta property="og:title" content="About | FURD BASE" />
    <meta property="og:description" content="Abuja's premier architecture, civil engineering, and real estate development firm." />
    <meta property="og:url" content="https://furdbase.com/about" />
    <meta name="twitter:card" content="summary_large_image" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2RXJWCXVWB"></script>
    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-2RXJWCXVWB');</script>
  </head>
  <body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white">
    <Header />
    <main class="pt-32 pb-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-20 max-w-3xl">
          <span class="font-display text-xs md:text-sm tracking-[0.3em] uppercase text-brand-red font-semibold mb-3 block">
            Who We Are
          </span>
          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase mb-8">
            Building the <span class="text-brand-red">Future</span> of Nigerian Architecture
          </h1>
          <p class="text-brand-gray text-base md:text-lg font-light leading-relaxed">
            FURD BASE is an integrated architecture, civil engineering, and real estate development firm with operations across <strong class="text-white">Nigeria</strong> and the <strong class="text-white">United Arab Emirates</strong>. From our headquarters in Abuja and regional office in Dubai, we design and deliver landmark residential and commercial developments that combine rigorous structural engineering with uncompromising design quality.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
          <div class="bg-brand-charcoal/50 border border-white/5 p-8 rounded-xl">
            <span class="font-condensed text-5xl font-bold text-brand-red/30 block mb-4">01</span>
            <h3 class="font-serif text-xl font-bold text-white mb-3">Our Mission</h3>
            <p class="text-brand-gray text-sm font-light leading-relaxed">
              To transform the built environment across Nigeria and the UAE through precision engineering and visionary architecture. Every project we undertake must elevate the standard of what's possible.
            </p>
          </div>
          <div class="bg-brand-charcoal/50 border border-white/5 p-8 rounded-xl">
            <span class="font-condensed text-5xl font-bold text-brand-red/30 block mb-4">02</span>
            <h3 class="font-serif text-xl font-bold text-white mb-3">Our Approach</h3>
            <p class="text-brand-gray text-sm font-light leading-relaxed">
              We treat every development as a technical case study. From geotechnical analysis to material specification to construction supervision, every decision is data-driven.
            </p>
          </div>
          <div class="bg-brand-charcoal/50 border border-white/5 p-8 rounded-xl">
            <span class="font-condensed text-5xl font-bold text-brand-red/30 block mb-4">03</span>
            <h3 class="font-serif text-xl font-bold text-white mb-3">Our Standard</h3>
            <p class="text-brand-gray text-sm font-light leading-relaxed">
              Eurocode 2 compliance, finite element structural analysis, corrosion-resistant detailing, and a 20-year structural warranty on every project we complete.
            </p>
          </div>
        </div>

        <div class="bg-brand-charcoal/30 border border-white/5 p-8 md:p-12 rounded-2xl mb-20">
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-white uppercase mb-6">Leadership</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="flex gap-6 items-start">
              <div class="w-16 h-16 rounded-full bg-brand-red/10 border border-brand-red/20 flex items-center justify-center flex-shrink-0">
                <span class="font-serif text-2xl font-bold text-brand-red">JH</span>
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold text-white">Mr. Jab</h3>
                <span class="text-[10px] uppercase tracking-widest text-brand-red block mb-2">Founder & Principal</span>
                <p class="text-brand-gray text-sm font-light">Anaezionwu Jabuike Henry, the visionary behind FURD BASE, with deep expertise in architectural design, structural engineering, and real estate development across Nigeria.</p>
              </div>
            </div>
            <div class="flex gap-6 items-start">
              <div class="w-16 h-16 rounded-full bg-brand-red/10 border border-brand-red/20 flex items-center justify-center flex-shrink-0">
                <span class="font-serif text-2xl font-bold text-brand-red">FB</span>
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold text-white">FURD BASE Team</h3>
                <span class="text-[10px] uppercase tracking-widest text-brand-gray block mb-2">Engineering & Design</span>
                <p class="text-brand-gray text-sm font-light">A multidisciplinary team of architects, structural engineers, project managers, and construction supervisors operating across Abuja and Lagos.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center">
          <a href="/#contact" class="inline-flex items-center justify-center px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold uppercase tracking-widest rounded-lg transition-all">
            Start a Conversation
          </a>
        </div>
      </div>
    </main>

    <ContactSection />

    <footer class="bg-brand-dark/95 border-t border-white/5 py-12 text-center text-xs text-brand-gray">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <img src="/assets/FURD-BASE-main-logo.png" alt="Logo" class="h-6 w-auto opacity-50" />
          <span class="font-serif tracking-widest text-white/60">FURD BASE</span>
        </div>
        <p>&copy; {new Date().getFullYear()} FURD BASE. All Rights Reserved. Abuja, Nigeria <span class="text-white/20 mx-1">|</span> Dubai, UAE</p>
        <div class="flex items-center gap-4">
          <a href="/" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Home</a>
          <a href="/blog" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Blog</a>
          <a href="/services" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Services</a>
          <span class="w-px h-4 bg-white/10"></span>
          <a
            href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/in/jabuike-aneazionwu-b54196418/'}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-red transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href={import.meta.env.PUBLIC_FACEBOOK_URL || 'https://www.facebook.com/1143285678875417'}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-red transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href={import.meta.env.PUBLIC_INSTAGRAM_URL || 'https://www.instagram.com/furd_base_limited'}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-red transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
