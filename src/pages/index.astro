---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RenderReality from '../components/RenderReality.astro';
import ProjectMatrix from '../components/ProjectMatrix.astro';
import ContactSection from '../components/ContactSection.astro';
import '../styles/global.css';

const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/';
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FURD BASE",
  "description": "Luxury architecture, civil engineering, and real estate development firm operating across Nigeria and the UAE.",
  "url": "https://furdbase.com",
  "image": "https://furdbase.com/assets/og-image.png",
  "logo": "https://furdbase.com/assets/FURD-BASE-main-logo.png",
  "address": [
    {
      "@type": "PostalAddress",
      "addressLocality": "Abuja",
      "addressRegion": "FCT",
      "addressCountry": "NG"
    },
    {
      "@type": "PostalAddress",
      "addressLocality": "Dubai",
      "addressCountry": "AE"
    }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "inquire@furdbase.com"
  },
  "sameAs": [linkedinUrl]
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE</title>
		<link rel="canonical" href="https://furdbase.com" />
		
		<!-- SEO Meta Tags -->
		<meta name="description" content="FURD BASE delivers luxury architecture, civil engineering, and real estate development across Nigeria and the UAE. Abuja headquarters with Dubai operations." />
		<meta name="keywords" content="Architect Abuja, Civil Engineering Nigeria, Real Estate Development Abuja, Luxury Residential Nigeria, Architect Dubai, Construction Contractor UAE, FURD BASE" />
		
		<!-- Open Graph / Social Sharing -->
		<meta property="og:title" content="FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE" />
		<meta property="og:description" content="Luxury architecture, engineering, and real estate development across Nigeria and the UAE. Explore our Render-to-Reality showcase and project matrix." />
		<meta property="og:image" content="https://furdbase.com/assets/og-image.png" />
		<meta property="og:url" content="https://furdbase.com" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="FURD BASE" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE" />
		<meta name="twitter:description" content="Luxury architecture, engineering, and real estate development across Nigeria and the UAE." />
		<meta name="twitter:image" content="https://furdbase.com/assets/og-image.png" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)}></script>
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-2RXJWCXVWB"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-2RXJWCXVWB');
		</script>
	</head>
	<body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white">
		<Header />
		<main>
			<Hero />
			<RenderReality />
			<ProjectMatrix />
			<ContactSection />
		</main>
		
		<!-- Footer -->
		<footer class="bg-brand-dark/95 border-t border-white/5 py-12 text-center text-xs text-brand-gray">
			<div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
				<div class="flex items-center gap-3">
					<img src="/assets/FURD-BASE-main-logo.png" alt="Logo" class="h-6 w-auto opacity-50" />
					<span class="font-serif tracking-widest text-white/60">FURD BASE</span>
				</div>
				<p>© {new Date().getFullYear()} FURD BASE. All Rights Reserved. Abuja, Nigeria <span class="text-white/20 mx-1">|</span> Dubai, UAE</p>
				<div class="flex items-center gap-4">
					<a href="/about" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">About</a>
					<a href="/services" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Services</a>
					<a href="/blog" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Journal</a>
					<span class="w-px h-4 bg-white/10"></span>
					<a href="https://wa.me/?text=Check%20out%20FURD%20BASE%20%E2%80%94%20luxury%20architecture%20and%20engineering%20in%20Nigeria%20and%20UAE%0Ahttps://furdbase.com" target="_blank" rel="noopener noreferrer" class="hover:text-green-500 transition-colors" aria-label="Share on WhatsApp">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
					</a>
					<a href="https://twitter.com/intent/tweet?text=Check%20out%20FURD%20BASE%20%E2%80%94%20luxury%20architecture%20and%20engineering%20in%20Nigeria%20and%20UAE&url=https://furdbase.com" target="_blank" rel="noopener noreferrer" class="hover:text-sky-500 transition-colors" aria-label="Share on X">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
					<a href="https://www.linkedin.com/sharing/share-offsite/?url=https://furdbase.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-500 transition-colors" aria-label="Share on LinkedIn">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
					<a href="https://www.facebook.com/sharer/sharer.php?u=https://furdbase.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors" aria-label="Share on Facebook">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
