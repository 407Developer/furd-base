---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RenderReality from '../components/RenderReality.astro';
import ProjectMatrix from '../components/ProjectMatrix.astro';
import ContactSection from '../components/ContactSection.astro';
import '../styles/global.css';

const linkedinUrl = import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/';
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FURD BASE",
  "description": "Luxury architecture, civil engineering, and real estate development firm operating across Nigeria and the UAE.",
  "url": "https://furdbase.ng",
  "image": "https://furdbase.ng/assets/FURD-BASE-main-logo.png",
  "logo": "https://furdbase.ng/assets/FURD-BASE-main-logo.png",
  "address": [
    {
      "@type": "PostalAddress",
      "addressLocality": "Abuja",
      "addressRegion": "FCT",
      "addressCountry": "NG"
    },
    {
      "@type": "PostalAddress",
      "addressLocality": "Dubai",
      "addressCountry": "AE"
    }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "inquire@furdbase.com"
  },
  "sameAs": [linkedinUrl]
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE</title>
		<link rel="canonical" href="https://furdbase.ng" />
		
		<!-- SEO Meta Tags -->
		<meta name="description" content="FURD BASE delivers luxury architecture, civil engineering, and real estate development across Nigeria and the UAE. Abuja headquarters with Dubai operations." />
		<meta name="keywords" content="Architect Abuja, Civil Engineering Nigeria, Real Estate Development Abuja, Luxury Residential Nigeria, Architect Dubai, Construction Contractor UAE, FURD BASE" />
		
		<!-- Open Graph / Social Sharing -->
		<meta property="og:title" content="FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE" />
		<meta property="og:description" content="Luxury architecture, engineering, and real estate development across Nigeria and the UAE. Explore our Render-to-Reality showcase and project matrix." />
		<meta property="og:image" content="/assets/real-1.jpeg" />
		<meta property="og:url" content="https://furdbase.ng" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="FURD BASE" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="FURD BASE | High-End Luxury Architecture & Engineering — Nigeria & UAE" />
		<meta name="twitter:description" content="Luxury architecture, engineering, and real estate development across Nigeria and the UAE." />
		<meta name="twitter:image" content="/assets/real-1.jpeg" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)}></script>
	</head>
	<body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white">
		<Header />
		<main>
			<Hero />
			<RenderReality />
			<ProjectMatrix />
			<ContactSection />
		</main>
		
		<!-- Footer -->
		<footer class="bg-brand-dark/95 border-t border-white/5 py-12 text-center text-xs text-brand-gray">
			<div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
				<div class="flex items-center gap-3">
					<img src="/assets/FURD-BASE-main-logo.png" alt="Logo" class="h-6 w-auto opacity-50" />
					<span class="font-serif tracking-widest text-white/60">FURD BASE</span>
				</div>
				<p>© {new Date().getFullYear()} FURD BASE. All Rights Reserved. Abuja, Nigeria <span class="text-white/20 mx-1">|</span> Dubai, UAE</p>
				<div class="flex items-center gap-4">
					<a href="/about" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">About</a>
					<a href="/services" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Services</a>
					<a href="/blog" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Journal</a>
					<span class="w-px h-4 bg-white/10"></span>
					<a
						href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/'}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-brand-red transition-colors"
						aria-label="LinkedIn"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
