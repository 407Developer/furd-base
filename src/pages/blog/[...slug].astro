---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = sorted.findIndex((p) => p.id === post.id);
const prev = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const next = currentIndex > 0 ? sorted[currentIndex - 1] : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={`https://furdbase.com/blog/${post.id}`} />
    <title>{post.data.title} | FURD BASE Blog</title>
    <meta name="description" content={post.data.description} />
    <meta property="og:title" content={`${post.data.title} | FURD BASE`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={`https://furdbase.com/blog/${post.id}`} />
    <meta property="og:type" content="article" />
    {post.data.image && <meta property="og:image" content={`https://furdbase.com${post.data.image}`} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/_astro/index.uxjtkwfg.css" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2RXJWCXVWB"></script>
    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-2RXJWCXVWB');</script>
  </head>
  <body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white">
    <Header />
    <main class="pt-32 pb-24">
      <article class="max-w-3xl mx-auto px-6">
        <div class="mb-12">
          <a href="/blog" class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-brand-gray hover:text-brand-red transition-colors mb-8">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Journal
          </a>

          <div class="flex items-center gap-3 mb-4">
            <span class="text-[10px] uppercase tracking-widest text-brand-gray">
              {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="text-brand-gray/30">|</span>
            <span class="text-[10px] uppercase tracking-widest text-brand-gray">{post.data.author}</span>
          </div>

          <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
            {post.data.title}
          </h1>

          <p class="text-brand-gray text-base md:text-lg font-light leading-relaxed">
            {post.data.description}
          </p>

          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {post.data.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-wider text-brand-red/80 bg-brand-red/5 px-3 py-1 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class="border-t border-white/5 pt-12">
          <div class="prose prose-invert max-w-none">
            <style>
              .prose h2 { font-family: 'Cinzel', serif; color: white; font-size: 1.75rem; margin-top: 3rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(159,19,31,0.2); }
              .prose h3 { font-family: 'Outfit', sans-serif; color: white; font-size: 1.25rem; margin-top: 2rem; margin-bottom: 0.75rem; font-weight: 600; }
              .prose p { color: #c0c0c0; font-size: 1rem; line-height: 1.9; margin-bottom: 1.5rem; font-weight: 300; }
              .prose strong { color: white; font-weight: 600; }
              .prose ul, .prose ol { color: #c0c0c0; font-size: 1rem; line-height: 1.9; margin-bottom: 1.5rem; padding-left: 1.5rem; }
              .prose li { margin-bottom: 0.6rem; }
              .prose table { width: 100%; border-collapse: collapse; margin: 2rem 0; font-size: 0.85rem; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.06); }
              .prose th { background: rgba(159, 19, 31, 0.12); color: white; padding: 0.85rem 1rem; text-align: left; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
              .prose td { padding: 0.85rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: #c0c0c0; }
              .prose tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
              .prose tr:last-child td { border-bottom: none; }
              .prose hr { border: none; height: 1px; background: linear-gradient(90deg, transparent, rgba(159,19,31,0.3), transparent); margin: 3rem 0; }
              .prose a { color: #9f131f; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
              .prose a:hover { color: white; }
              .prose blockquote { border-left: 3px solid #9f131f; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); font-style: italic; margin: 2rem 0; background: rgba(159,19,31,0.04); border-radius: 0 8px 8px 0; }
              .prose img { width: 100%; border-radius: 10px; margin: 2.5rem 0; border: 1px solid rgba(255,255,255,0.06); }
              .prose code { background: rgba(159,19,31,0.1); color: #e0e0e0; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
              .prose pre { background: #121214; border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 1.25rem; overflow-x: auto; margin: 1.5rem 0; }
              .prose pre code { background: none; padding: 0; }
            </style>
            <Content />
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-8 pt-8 border-t border-white/5">
          <span class="text-[10px] uppercase tracking-widest text-brand-gray">Share this post</span>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' — FURD BASE\nhttps://furdbase.com/blog/' + post.id)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-green-500/50 hover:bg-green-500/10 transition-colors"
            aria-label="Share on WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent('https://furdbase.com/blog/' + post.id)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-sky-500/50 hover:bg-sky-500/10 transition-colors"
            aria-label="Share on X"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://furdbase.com/blog/' + post.id)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-blue-500/50 hover:bg-blue-500/10 transition-colors"
            aria-label="Share on LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://furdbase.com/blog/' + post.id)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center hover:border-blue-600/50 hover:bg-blue-600/10 transition-colors"
            aria-label="Share on Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>

        <div class="flex justify-between items-center mt-8 pt-8 border-t border-white/5">
          {prev ? (
            <a href={`/blog/${prev.id}`} class="group text-left">
              <span class="text-[10px] uppercase tracking-widest text-brand-gray">Previous</span>
              <span class="block text-sm font-semibold text-white group-hover:text-brand-red transition-colors mt-1">{prev.data.title}</span>
            </a>
          ) : <div></div>}
          {next ? (
            <a href={`/blog/${next.id}`} class="group text-right">
              <span class="text-[10px] uppercase tracking-widest text-brand-gray">Next</span>
              <span class="block text-sm font-semibold text-white group-hover:text-brand-red transition-colors mt-1">{next.data.title}</span>
            </a>
          ) : <div></div>}
        </div>
      </article>
    </main>

    <footer class="bg-brand-dark/95 border-t border-white/5 py-12 text-center text-xs text-brand-gray">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <img src="/assets/FURD-BASE-main-logo.png" alt="Logo" class="h-6 w-auto opacity-50" />
          <span class="font-serif tracking-widest text-white/60">FURD BASE</span>
        </div>
        <p>&copy; {new Date().getFullYear()} FURD BASE. All Rights Reserved. Abuja, Nigeria <span class="text-white/20 mx-1">|</span> Dubai, UAE</p>
        <div class="flex items-center gap-4">
          <a href="/" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Home</a>
          <a href="/blog" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Blog</a>
          <span class="w-px h-4 bg-white/10"></span>
          <a
            href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/'}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-red transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
