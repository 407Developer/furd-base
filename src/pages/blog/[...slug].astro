---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = sorted.findIndex((p) => p.id === post.id);
const prev = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const next = currentIndex > 0 ? sorted[currentIndex - 1] : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/assets/FURD-BASE-main-logo.png" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={`https://furdbase.ng/blog/${post.id}`} />
    <title>{post.data.title} | FURD BASE Blog</title>
    <meta name="description" content={post.data.description} />
    <meta property="og:title" content={`${post.data.title} | FURD BASE`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={`https://furdbase.ng/blog/${post.id}`} />
    <meta property="og:type" content="article" />
    {post.data.image && <meta property="og:image" content={post.data.image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/_astro/index.uxjtkwfg.css" />
  </head>
  <body class="bg-brand-dark text-white selection:bg-brand-red selection:text-white">
    <Header />
    <main class="pt-32 pb-24">
      <article class="max-w-3xl mx-auto px-6">
        <div class="mb-12">
          <a href="/blog" class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-brand-gray hover:text-brand-red transition-colors mb-8">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Journal
          </a>

          <div class="flex items-center gap-3 mb-4">
            <span class="text-[10px] uppercase tracking-widest text-brand-gray">
              {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="text-brand-gray/30">|</span>
            <span class="text-[10px] uppercase tracking-widest text-brand-gray">{post.data.author}</span>
          </div>

          <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-4">
            {post.data.title}
          </h1>

          <p class="text-brand-gray text-base md:text-lg font-light leading-relaxed">
            {post.data.description}
          </p>

          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {post.data.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-wider text-brand-red/80 bg-brand-red/5 px-3 py-1 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class="border-t border-white/5 pt-12">
          <div class="prose prose-invert max-w-none">
            <style>
              .prose h2 { font-family: 'Cinzel', serif; color: white; font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 1rem; }
              .prose h3 { font-family: 'Outfit', sans-serif; color: white; font-size: 1.25rem; margin-top: 2rem; margin-bottom: 0.75rem; font-weight: 600; }
              .prose p { color: #a1a1a6; font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.25rem; font-weight: 300; }
              .prose strong { color: white; font-weight: 600; }
              .prose ul, .prose ol { color: #a1a1a6; font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.25rem; padding-left: 1.5rem; }
              .prose li { margin-bottom: 0.5rem; }
              .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.85rem; }
              .prose th { background: rgba(159, 19, 31, 0.1); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.7rem; border: 1px solid rgba(255,255,255,0.05); }
              .prose td { padding: 0.75rem 1rem; border: 1px solid rgba(255,255,255,0.05); color: #a1a1a6; }
              .prose tr:nth-child(even) { background: rgba(255,255,255,0.02); }
              .prose hr { border-color: rgba(255,255,255,0.05); margin: 2rem 0; }
              .prose a { color: #9f131f; text-decoration: underline; text-underline-offset: 2px; }
              .prose a:hover { color: white; }
              .prose blockquote { border-left: 2px solid #9f131f; padding-left: 1.25rem; color: rgba(255,255,255,0.7); font-style: italic; margin: 1.5rem 0; }
            </style>
            <Content />
          </div>
        </div>

        <div class="flex justify-between items-center mt-16 pt-8 border-t border-white/5">
          {prev ? (
            <a href={`/blog/${prev.id}`} class="group text-left">
              <span class="text-[10px] uppercase tracking-widest text-brand-gray">Previous</span>
              <span class="block text-sm font-semibold text-white group-hover:text-brand-red transition-colors mt-1">{prev.data.title}</span>
            </a>
          ) : <div></div>}
          {next ? (
            <a href={`/blog/${next.id}`} class="group text-right">
              <span class="text-[10px] uppercase tracking-widest text-brand-gray">Next</span>
              <span class="block text-sm font-semibold text-white group-hover:text-brand-red transition-colors mt-1">{next.data.title}</span>
            </a>
          ) : <div></div>}
        </div>
      </article>
    </main>

    <footer class="bg-brand-dark/95 border-t border-white/5 py-12 text-center text-xs text-brand-gray">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <img src="/assets/FURD-BASE-main-logo.png" alt="Logo" class="h-6 w-auto opacity-50" />
          <span class="font-serif tracking-widest text-white/60">FURD BASE</span>
        </div>
        <p>&copy; {new Date().getFullYear()} FURD BASE. All Rights Reserved. Abuja, Nigeria <span class="text-white/20 mx-1">|</span> Dubai, UAE</p>
        <div class="flex items-center gap-4">
          <a href="/" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Home</a>
          <a href="/blog" class="hover:text-brand-red transition-colors text-[10px] uppercase tracking-wider">Blog</a>
          <span class="w-px h-4 bg-white/10"></span>
          <a
            href={import.meta.env.PUBLIC_LINKEDIN_URL || 'https://www.linkedin.com/company/furd-base/'}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-red transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
